        <mxCell id="jiw4D1npWr8cNXSQTgrQ-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="1.Can handle Million of Uploads daily&lt;div&gt;2.Can handle Billion of Views Daily&lt;/div&gt;&lt;div&gt;i.e -read heavy&lt;/div&gt;&lt;div&gt;=&amp;gt;&lt;/div&gt;&lt;div&gt;HORIZONTAL SCALING&lt;/div&gt;&lt;div&gt;AVAILABLITY&amp;gt;CONSISTENCY(EVENTUAL)&lt;/div&gt;&lt;div&gt;LATENCY--------CAN BE LOW FOR UPLOADS&lt;/div&gt;&lt;div&gt;------------FAST FOR VIEWS&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="290" width="340" x="775" y="170" as="geometry" />
        </mxCell>
        <mxCell id="jiw4D1npWr8cNXSQTgrQ-9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="API _GATEWAYS" vertex="1">
          <mxGeometry height="60" width="750" x="365" y="500" as="geometry" />
        </mxCell>
        <mxCell id="jiw4D1npWr8cNXSQTgrQ-10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="1.Auth-userAPIs&lt;div&gt;POST /api/auth/signup&lt;/div&gt;&lt;div&gt;POST /api/auth/login&lt;br&gt;POST /api/auth/logout&lt;br&gt;POST /api/auth/refresh-token&lt;/div&gt;&lt;div&gt;User-apis&lt;/div&gt;&lt;div&gt;GET    /api/users/{userId}&lt;br&gt;PUT    /api/users/{userId}&lt;br&gt;PATCH  /api/users/{userId}/profile-photo&lt;br&gt;DELETE /api/users/{userId}&lt;/div&gt;&lt;div&gt;2.Video Upload and Management apis&lt;/div&gt;&lt;div&gt;POST /api/videos/upload&lt;br&gt;POST /api/videos/upload/initiate&lt;br&gt;POST /api/videos/upload/chunk&lt;br&gt;POST /api/videos/upload/complete&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;POST /api/videos/{videoId}/transcode&lt;/span&gt;&lt;/div&gt;POST /api/videos/{videoId}/generate-thumbnail&lt;br&gt;GET  /api/videos/{videoId}/processing-status&lt;div&gt;3.video fetch and watch apis&lt;/div&gt;&lt;div&gt;GET /api/videos/{videoId}&lt;br&gt;GET /api/videos/{videoId}/stream-url&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="500" width="410" x="365" y="560" as="geometry" />
        </mxCell>
        <mxCell id="jiw4D1npWr8cNXSQTgrQ-11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="4.like dislike views and cmments&amp;nbsp;&lt;div&gt;POST   /api/videos/{videoId}/like&lt;br&gt;POST   /api/videos/{videoId}/dislike&lt;br&gt;DELETE /api/videos/{videoId}/like&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;POST /api/videos/{videoId}/view&lt;/span&gt;&lt;/div&gt;GET  /api/videos/{videoId}/views&lt;div&gt;GET    /api/videos/{videoId}/comments&lt;br&gt;POST   /api/videos/{videoId}/comments&lt;br&gt;PUT    /api/comments/{commentId}&lt;br&gt;DELETE /api/comments/{commentId}&lt;/div&gt;&lt;div&gt;5.Subscription apis&amp;nbsp;&lt;/div&gt;&lt;div&gt;POST   /api/channels/{channelId}/subscribe&lt;br&gt;DELETE /api/channels/{channelId}/unsubscribe&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;GET /api/subscriptions/feed&lt;/span&gt;&lt;/div&gt;GET /api/subscriptions/channels&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="500" width="340" x="775" y="560" as="geometry" />
        </mxCell>
